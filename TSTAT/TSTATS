FILES  DATA >0014,>0000,FILEBUF,0,0,0,0
       BYTE 0,9
       TEXT 'PI.STATUS   '
;;     TEXT 'DSK5.TEST   '    ;TYPE PI.STATUS>DSK5.TEST, Edit, and test

FILEU  DATA >0014,>0000,FILEBUF,0,0,0,0
