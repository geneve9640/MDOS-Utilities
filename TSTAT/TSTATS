       BYTE 13,10,0

DONE   TEXT 'complete!'
       BYTE 13,10,0

CTRLC  TEXT '^C, program halted'
       BYTE 13,10,0


NOUPGRADE
       TEXT ' - No update available'
       BYTE 13,10,0

YESUPGRADE
       TEXT ' ** TIPI Update available! Use option [U]'
       BYTE 13,10,0

EPROMVER
       TEXT 'TIPI EPROM: '
       BYTE 0

HELLO  BYTE 13,10
       TEXT 'If you are reading this, you are doing more than running me!'
       BYTE 9

CRLF2  BYTE 13,10,0           *cr/lf combo for ttyout
H32    BYTE >20
HFF    BYTE >FF
FIVE   DATA 5
VIDEO  DATA 6            video xop
MEM    DATA 7            memory manager xop
IO     DATA 8            i/o xop
UTIL   DATA 9            utility xop
HEXA   DATA 10

; File opcodes
FOPEN  BYTE >00
FCLOSE BYTE >01
FREAD  BYTE >02
FWRITE BYTE >03

SIXTEEN     DATA 16
HEXDEC TEXT '0123456789ABCDEF'
;
; Consolidate to one PAB with a call/etc later if desired
;      We have plenty of space so we'll keep things simple for now
;      This also facilitates testing the functions using a file on disk
;
FILEC  DATA >0014,>0000,FILEBUF,0,0,0,0
       BYTE 0,9
