       TEXT 'PI.UPGRADE  '

; >12 is output; >14 input
FILEH  DATA >0012,>0000,FILEBUF,0,0,0,0
       BYTE 0,11
       TEXT 'PI.SHUTDOWN '

FILER  DATA >0012,>0000,FILEBUF,0,0,0,0
       BYTE 0,9
       TEXT 'PI.REBOOT   '
