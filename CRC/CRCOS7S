; MDOS TTYOUT
; Destroys R0,R1,R2
TTYOUT MOV  *R11+,R1     ;3.16.2024, simplified
       MOV  *R11+,R2     ;either len or 0 for null term
       LI   R0,>0027
       XOP  @VIDEO,0
       RT

