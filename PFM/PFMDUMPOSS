********************************************************************************
; PFMDUMPOS - Dump MDOS from PFM to file
;
;03.21.2024   Created utility
;03.21.2024   Use CRCOS7 or PFMCRC to validate the OS
;           $ Could test file for protection first via status opcode...
;
;03.25.2024 Inhibited from writing to a device!  Bwrite is dangerouse!
;
;-------------------------------------------------------------------------------
CYACRC# EQU >0000        configure crc buffers in this file (see crcmains)

WS     EQU  >F000        my workspace
*
MAIN3  LWPI WS          LET'S LOAD OUR WORKSPACE
       LIMI 0            turn off those interrupts!
       BL   @TTYOUT      Give user a title
       DATA TITLE1,0

       BL   @PRODID      check product ID and get parameters
       MOV  R0,R0
       JNE  PFMFOUND

       BL   @TTYOUT      no PFM; abort
       DATA PFMERR,0

       B    @EXIT


PFMFOUND
       BL   @TTYOUT      PFM identified; show information to user
       DATA PFMDEV,0

       BL   @PRTHEX
       DATA PRODID#,2

       MOV  @PFM_TEXT,@TTXX
       BL   @TTYOUT
TTXX   DATA 0,0

       BL   @TTYOUT
       DATA CRLF2,0

       CLR  R0           Begin setting up for extra memory
       XOP  @MEM,0       get free pages
       CI   R1,OSTOTPAGES   ;136k for v7.x
       JL   BYBY         if fewer available, exit..

       LI   R0,1         get pages (R1 holds number available for our use)
       LI   R2,8         VIRTUAL page 8 (pagetable starts AFTER 64K)
       CLR  R3           Any RAM is ok
       XOP  @MEM,0       get the RAM
       ABS  R0           error?
       JEQ  MEMOK        no

BYBY   BL   @TTYOUT      memory error - report it!
       DATA NOMEM,0
       B    @EXIT

MEMOK  LI   R0,4         get the memory table
       LI   R1,PGETBL    and put it into the page table
       LI   R2,254       this is overdoing it for 2Meg system, but who cares
       XOP  @MEM,0       do it!
***********************
* GET THE FILE FROM CLI
*
* parse routine from who knows where... at least it works
*
       LI   R0,>3200          50 bytes for WORK length
       LI   R1,WORK-1         patch it
       MOVB R0,*R1+           crunch command line and move it to WORK
       MOV  @>0128,R2         get command line argument address
       JEQ  NOGOT             if no arguments
       CB   @2(R2),@-1(R1)    see if command line is too long
       JHE  NOGOT             if too long
       MOV  R1,R5             else save address of WORK to R5
       DEC  R5                to length pointer
       MOVB @2(R2),R6         argument length
       SRL  R6,8              make it a word
       INCT R6                add two

NXTNOD MOV  R2,R3             save command address
       INCT R3                add 2
       MOV  R2,R4
       AI   R4,8
GETNOD MOVB *R3+,*R5+         start moving the data
       DEC  R6                till count is done
       JEQ  GOTCMD

       C    R3,R4             r3 holds node count
       JL   GETNOD            if done this node, go get some more
       MOV  *R2,R2            get next node
       JMP  NXTNOD
*
GOTCMD MOVB @WORK-1,R1   length of argument
       JEQ  NOGOT        if no arg
       SRL  R1,8         else make it a word
       INC  R1           and add 1 for the loop conter

       LI   R2,40        largest filename possible
       LI   R4,WORK      address of command line text
GETFIL CB   *R4+,@H32    look for a space in the command line (filename)
       JLE  GOTFIL       if ASCII 0-32, we have the filename
       DEC  R1           don't have it yet, count down
       JEQ  NOGOT        we done with arguments?
       DEC  R2           we done with the 40 possible bytes of filename?
       JNE  GETFIL

NOGOT  BL   @TTYOUT
       DATA TITLE2,0
       BL   @TTYOUT
       DATA USAGE,0
       B    @EXIT
*
GOTFIL
SETUPTHEPARSE
       CLR  R0           we have the filename, now put a null at end
       DEC  R4           back to the previous byte
       MOVB R0,*R4       then write a null
       LI   R0,8         parse the filename
       LI   R1,WORK      get logical filename from here
       LI   R2,LEN+1     and put hardware name in the pab
       CLR  R3           what the hell is an alias prefix?
       XOP  @UTIL,0      go do the parse
*
*ALL DONE PARSING, GETTING NAME, ETC.  NOW TO THE GOOD STUFF!
*----------------------------------------------------------------------------
*
       BL   @TTYOUT
       DATA SAVING,0     ;saving file!

       MOVB  @LEN+1,@SHOWIT+3
       BL   @TTYOUT
SHOWIT DATA FNAME,1      show parsed name

       BL   @TTYOUT
       DATA CRLF2,0

       CB  @LEN+1,@KEY+1  Trying to save to device (direct sector io!)
       JH  SVOK1          no
       BL   @TTYOUT       yes, error! exit
       DATA NOTDEVICE,0
       JMP  EXIT

SVOK1  LI   R0,FILE
       XOP  @IO,0
       MOVB @FILE+2,R1        check for an error
       JEQ  GOODFILE2         wrong file, incorrect size, etc
       BL   @TTYOUT           show the error
       DATA IOERR,0
       JMP  EXIT


GOODFILE2
       BL   @LOADPFM     read OS from PFM into memory

       LI   R0,FILE
       LI   R1,FILEBW
       LI   R2,7              ;14 byte
SETBW  MOV  *R1+,*R0+
       DEC  R2
       JNE  SETBW


       LI   R0,FILE
       XOP  @IO,0
       MOVB @FILE+2,R1
       JEQ  GOODFILE3
       BL   @TTYOUT
       DATA IOERR2,0
       JMP  EXIT

GOODFILE3
       BL   @TTYOUT
       DATA IOGOOD,0

*------------------------------
EXIT   BL   @TTYOUT           normal exit
       DATA CRLF2,2           with a CRLF
       LI   R0,>06            RELEASE MDOS MEMORY
       LI   R1,1
       XOP  @MEM,0
       BLWP @0                Thank MDOS for working so well, then exit

*-------------------------------------------------------------------------------
* This may be a bit different, but I got it to work.  Prints the HEX
* representation starting with the byte pointed to by R3.  R7 contains the
* number of bytes to print (starting at R3).
*
PRTHEX MOV  *R11+,R3          get the starting location
       MOV  *R11+,R7          get the number of bytes to print
       LI   R0,>27            TTYOUT
       LI   R1,WS+12          use R6 as the location to print from
       LI   R2,1              one char to print

PRT2   MOVB *R3+,R5           get the next byte
       SRL  R5,8              make it a word value
       CLR  R4                clear R4 for the divide
       DIV  @SIXTEEN,R4       divide this by sixteen
       MOVB @HEXDEC(R4),R6    get the ASCII character (pointer to by R4)
       XOP  @VIDEO,0          print it
       MOVB @HEXDEC(R5),R6
       XOP  @VIDEO,0
       MOV  R7,R6             move R7 (byte value)
       ANDI R6,>0001          mask all but bit 1
       JEQ  NOSPACE           if zero, jump (must have been an even byte)
       MOVB @H32,R6           ah-ha.. odd!  let's print a space to separate the
       XOP  @VIDEO,0          words of hex.
NOSPACE
       DEC  R7                any more to do?
       JNE  PRT2              yup
       RT                     no, return

**************************
* MDOS write tty routine *
**************************
TTYOUT MOV  *R11+,R1     get data address
       MOV  *R11+,R2     get length of data to write
       LI   R0,>0027
       XOP  @VIDEO,0
       RT


       COPY "PRODIDS"
       COPY "PFMREADS"
       COPY "..\CRC\CRCMAINS"        3.17.2024 final


* end of code, data follows
*
NOMEM  TEXT 'Insufficient Memory.'
       BYTE >0D,>0A,0
       EVEN

SAVING BYTE 13,10
       TEXT 'Saving... '
       BYTE 0
       BYTE 13,10,0

IOGOOD BYTE 13,10
       TEXT 'OS saved successfully!  Test with CRCOS7 or PFMCRC'
       BYTE 13,10,0

TITLE1
       BYTE 13,10
       TEXT 'PFMDUMPOS, Dump OS from PFM to file v1.0     [25 March 2024tt]'
       BYTE 13,10,0

TITLE2 TEXT ' '
       BYTE 0

USAGE  BYTE 13,10,9
       TEXT 'Usage:  PFMDUMPOS mdosfile      (quotes around backslash)'
       BYTE 13,10,0

IOERR  BYTE 13,10
       TEXT 'File Error - could not create file'
       BYTE 13,10,10,0

IOERR2 BYTE 13,10
       TEXT 'File Error - could save OS to file'
       BYTE 13,10,10,0

NOTDEVICE
       BYTE 13,10
       TEXT 'Cannot save to a device! Program halted.'
       BYTE 13,10,10,0


CRLF2  BYTE 13,10,0           *cr/llf combo for ttyout
H32    BYTE >20
HFF    BYTE >FF
KEY    DATA 5
VIDEO  DATA 6            video xop
MEM    DATA 7            memory manager xop
IO     DATA 8            i/o xop
UTIL   DATA 9            utility xop
HEXA   DATA 10

PAGELIST    DATA >F0F1,>F2F3,>F4F5,>F6F7
            DATA >F9FA,>FBFC,>FDFE    ;,>FFFF
;populate FFFE backwards until we fix the PFM copy routine
            DATA >FFFF   ;flip to bank 3 for 2nd >FF
            DATA >FE00   ;and FE
            DATA 0

HC     BYTE >AA
HD     BYTE >55
HE     BYTE >A0
       BYTE 0
       EVEN

SIXTEEN     DATA 16
HEXDEC TEXT '0123456789ABCDEF'
*

;                        |-sectors for the file
;                        |         |-sector used in file
FILEID DATA >0000,>0100,544,>0000,544,>0000,>0000,>0000,>0000,>0000
;                  |program image       |-----|-----|------|
;                                       date time  date time
;

;copy this to write the file data
FILEBW DATA >0B00,>0001,0,>0000,0,0,544      ;MDOS 7.0+ ; TIPI requires BREAD

; Pab                                   |-write via FILEID
FILE  DATA >0B00,>0000,FILEID,>0000,0,0,0     ;MDOS 7.0+ ; TIPI requires BRE
LEN   DATA >0028   * --> status byte / length byte
FNAME  EQU  $

WORK   EQU  FNAME+50
PGETBL EQU  WORK+80                          ;memory map

; see CRCMAINS
CRCTABLE512 EQU  PGETBL+264                  ;table
SAVE9995    EQU  CRCTABLE512+520             ;store 9995 during crc
NEXTBUF     EQU  SAVE9995+256                ;placeholder

*---------------------------------------------------------
       END

