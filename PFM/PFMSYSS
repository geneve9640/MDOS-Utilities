       DATA PROGRAMYN,0

       CLR  R0
KEYL2  XOP  @KEY,0
       SRL  R1,8
       ANDI R1,>005F
       CI   R1,'Y'
       JEQ  PROGRAMIT
       CI   R1,'N'
       JEQ  EXIT
